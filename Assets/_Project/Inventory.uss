.container {
	flex-grow: 1;
	width: auto;
	height: auto;
	max-width: none;
	max-height: none;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	-unity-font-definition: url('');
	text-shadow: 2px 2px 2px rgba(0,0,0,0.5);
	color: rgb(255, 197, 0);
}

.inventory {
	background-image: url('');
	width: 300px;
	padding: 10px;
	max-height: 500px; 
}

.inventoryHeader {
	position: absolute;
	top: -32px;
	left: -27px;
	width: 350px;
	height: 70px;
	justify-content:center;
	align-items: center;
	background-image: url('');
	-unity-slide-scale: 0.5; /* If images are too big or small, then use this value to scale */
}

Label {
	font-size: 24px;
}

.inventoryFrame {
	position: absolute;
	top: -10px;
	left: -17px;
	width: 326px;
	height: 520px;
	background-image: url('');
	-unity-slice-scale: 0.5;
}

.slotsContainer {
	flex-grow: 1;
	padding-top: 30px;
	flex-wrap: wrap;
	flex-direction: row;
	align-items: flex-start;
	justify-content: flex-start;
	flex-shrink: 0;
}

	.slot {
		width: 60px;
		height: 60px;
		margin: 4px;
	}

	.slotFrame {
		position: aboslute;
		top: 0;
		left: 0;
		width: 60px;
		height: 60px;
		border-width: 0;
		background-image: url('');
		-unity-slice-scale: 0.8;
	}

	.slotIcon {
		padding: 4px;
		flex-shrink: 0;
		flex-grow: 1;
	}

	.ghostIcon {
		visibility: hidden;
		position: absolute;
		width: 60px;
		height: 60px;
		background-image: none;
	}